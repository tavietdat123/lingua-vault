{
  "expo": {
    "name": "LinguaVault",
    "slug": "lingua-vault",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090d16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.linguavault.app",
      "buildNumber": "3",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.linguavault.app",
      "versionCode": 3,
      "usesCleartextTraffic": true,
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090d16"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/alarm.wav"
          ],
          "defaultChannel": "hardcore-alarm-v1",
          "color": "#ef4444"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3d6722d8-5393-4a2b-9a84-255bdfef7ca8"
      }
    }
  }
}
