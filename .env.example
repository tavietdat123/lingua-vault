# =========================================================================
# LINGUAVAULT - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================

# Môi trường chạy và Cổng ứng dụng nội bộ
NODE_ENV=production
PORT=5001

# Google Gemini API Key (Dùng cho AI Quiz Generator, Paraphrasing, Speaking Lab)
# Đăng ký miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Chuỗi ký bí mật Token xác thực JWT (Hãy đổi chuỗi này thành 1 chuỗi ngẫu nhiên dài)
JWT_SECRET=your_super_secret_jwt_random_string_2026

# Tùy chọn: Telegram Bot Token & Chat ID (Nếu muốn kích hoạt nhắc học qua Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
